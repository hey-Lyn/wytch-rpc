{
  "name": "wytch-rpc",
  "version": "1.0.3",
  "description": "Discord Rich Presence para o YouTube. Extensão + servidor local, protocolo IPC puro, zero dependências em runtime.",
  "private": true,
  "bin": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "test": "node tools/run-tests.js",
    "icons": "node tools/generate-icons.js",
    "diag": "node tools/diag-pipe.js",
    "build:exe": "pkg server/server.js --targets node22-win-x64 --output dist/wytch-rpc.exe"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "discord",
    "rich-presence",
    "youtube",
    "chrome-extension",
    "ipc",
    "nodejs"
  ],
  "license": "MIT",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
