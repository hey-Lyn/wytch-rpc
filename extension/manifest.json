{
  "manifest_version": 3,
  "name": "Wytch RPC",
  "version": "1.0.0",
  "description": "Mostra no seu status do Discord o que você está assistindo no YouTube: título, canal, timestamp, thumbnail e botão para assistir na hora exata.",
  "author": "hey-Lyn",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:4444/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Wytch RPC — configuração",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}